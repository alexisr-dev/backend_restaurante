# Plantilla de entorno para backend_restaurante.
# Copia este archivo como .env y reemplaza los valores entre <> por los tuyos.
# El archivo .env real NUNCA se sube al repositorio (ver .gitignore); solo
# esta plantilla se versiona.

SECRET_KEY=<genera-una-clave-con-get_random_secret_key-o-secrets.token_urlsafe>

# Debe ser IDENTICO al JWT_SECRET de backend_fastapi; si no coinciden, el
# login funciona pero ese servicio responde 401 a todo.
JWT_SECRET=<mismo_secreto_que_backend_fastapi>
JWT_ALGORITHM=HS256
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=America/Lima

DB_NAME=<nombre_de_tu_base_de_datos>
DB_USER=postgres
DB_PASSWORD=<contraseña_de_tu_postgres>
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
